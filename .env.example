# Copy to .env and fill in. Every value below is required unless marked optional.
# Nothing in this file should ever be a real credential.

# Supabase project — Project Settings > API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<anon key>
SUPABASE_ANON_KEY=<anon key>
SUPABASE_SERVICE_KEY=<service_role key, server only, never sent to a browser>
SUPABASE_WEBHOOK_SECRET=<a long random string; must match the Supabase webhook>
SUPABASE_SYNC_ENABLED=true

# Django
SECRET_KEY=<django secret key>
DEBUG=true

# Where Supabase sends the user back after email verification
SUPABASE_SITE_URL=http://localhost:8000
SITE_DOMAIN=localhost:8000
SITE_PROTOCOL=http

# Outbound mail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SENDER_NAME=Nexus
SENDER_EMAIL=<from address>
EMAIL_HOST_USER=<smtp user>
EMAIL_HOST_PASSWORD=<smtp password or app password>

# Assistant (optional; the assistant answers from the database without it)
MISTRAL_API_KEY=<mistral api key>

BYPASS_SUPABASE=False
AUTO_VERIFY_USERS=False
